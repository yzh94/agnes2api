# ========== Agnes API 配置 ==========
# 上游 Agnes API 的 Base URL
AGNES_BASE_URL=https://apihub.agnes-ai.com

# ========== 服务配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT 签名秘钥 (请务必修改为一个随机长字符串，至少 32 字符)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# 请求超时（秒），视频生成等可能需要较长时间
REQUEST_TIMEOUT=300

# 并行调用开关 (true: 生成多张图片时并发请求上游)
ENABLE_PARALLEL_CALLS=true
