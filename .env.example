# ========== Agnes API 配置 ==========
# 上游 Agnes API 的 Base URL
AGNES_BASE_URL=https://apihub.agnes-ai.com

# 仅作为首次启动建库时的种子 (Seed)
# 后续增删改渠道请在浏览器打开控制台 (http://ip:8000/) 面板操作

# ========== 核心网关配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 数据库连接字符串（仅支持 MySQL）
# 格式: mysql+aiomysql://username:password@host:port/dbname
# 示例: mysql+aiomysql://root:password@localhost:3306/agnes2api
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/agnes2api

# Redis 连接字符串 (用于鉴权双缓存、队列、状态同步)
# 格式: redis://[:password@]host:port/db
REDIS_CONN_STRING=redis://localhost:6379/0

# 管理后台 JWT 签名秘钥 (请务必在生产环境修改为一个随机长字符串)
JWT_SECRET=your_super_secret_jwt_key_here

# 请求超时（秒），视频生成等可能需要较长时间
REQUEST_TIMEOUT=300

# ========== 性能优化配置 ==========
# 并行调用开关 (true: 生成多张图片时并发请求上游，极速响应)
ENABLE_PARALLEL_CALLS=true

# 缓存开关与配置
ENABLE_CACHE=false
CACHE_MAX_SIZE=1000
CACHE_TTL=3600
CACHE_KEY_PREFIX=agnes2api

# ========== LLM 内容日志配置 ==========
# 是否记录每个用户 LLM 调用的输入/输出内容到 logs/llm/llm-YYYY-MM-DD.jsonl
LLM_CONTENT_LOG_ENABLED=false

# ========== Docker 部署相关 ==========
# DEV_MODE=true 启用热重载 / false 生产模式
DEV_MODE=false
UVICORN_WORKERS=4

# ========== Discord OAuth 登录配置 ==========
# 访问 https://discord.com/developers/applications 创建应用后填写
# 授权回调地址需设置为: http(s)://你的域名/api/manage/discord/callback
# 权限设置: OAuth2 -> 权限 -> 勾选 "Identify"
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/manage/discord/callback
